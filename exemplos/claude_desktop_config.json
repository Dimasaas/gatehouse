{
  "mcpServers": {
    "gatehouse-ana-atendimento": {
      "command": "node",
      "args": ["/caminho/para/gatehouse/src/index.js"],
      "env": {
        "MCP_PESSOA": "ana_atendimento",
        "MCP_ESCOPOS": "/caminho/para/gatehouse/exemplos/escopos.json",
        "MCP_DADOS": "/caminho/para/gatehouse/exemplos/dados.json",
        "MCP_AUDITORIA": "/caminho/para/gatehouse/auditoria.jsonl"
      }
    },
    "gatehouse-bruno-analise": {
      "command": "node",
      "args": ["/caminho/para/gatehouse/src/index.js"],
      "env": {
        "MCP_PESSOA": "bruno_analise"
      }
    }
  }
}
